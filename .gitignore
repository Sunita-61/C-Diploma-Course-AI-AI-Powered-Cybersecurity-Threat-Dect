# Streamlit local state
.streamlit/

# Large Datasets & Generated Data (keep structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/simulated/*
!data/simulated/.gitkeep

# Trained models (keep structure via .gitkeep)
models/*
!models/.gitkeep

# Reports, alerts, and figures generated dynamically
outputs/reports/*
!outputs/reports/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/alerts/*
!outputs/alerts/.gitkeep

# Sensitive and temporary files
*.log
.env
.env.*
*.bak
Thumbs.db
desktop.ini
